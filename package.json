{
  "name": "pulsegate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:local": "node scripts/local-env.mjs && wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc --persist-to .wrangler/state",
    "dev": "concurrently -k -n frontend,worker \"npm:dev:frontend\" \"npm:dev:worker\"",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --config wrangler.dev.jsonc --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy && wrangler d1 migrations apply DB --remote",
    "deploy:button": "node scripts/deploy-button.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "chart.js": "^4.5.1",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vuetify": "^4.2.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.42.0"
  }
}
